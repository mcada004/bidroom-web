rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared auth helpers.
    function isSignedIn() {
      return request.auth != null;
    }

    function isFantasyDraftAdmin() {
      return isSignedIn() &&
        request.auth.token.get("email", "") == "mcada004@gmail.com";
    }

    function isActiveFantasyMember(draftId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/fantasyDrafts/$(draftId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/fantasyDrafts/$(draftId)/members/$(request.auth.uid)).data.status == "active";
    }

    function isValidFantasyName(name) {
      return name is string && name.size() >= 2 && name.size() <= 24 && name.matches('^\\S.*\\S$');
    }

    function isValidSharedFantasyPick(allowMine) {
      return request.resource.data.keys().hasOnly([
          "status",
          "actorName",
          "actorUid",
          "updatedAt",
          "origin"
        ]) &&
        (
          (!allowMine && request.resource.data.status == "X") ||
          (allowMine && request.resource.data.status == "D")
        ) &&
        isValidFantasyName(request.resource.data.actorName) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.origin == "named-room-v1" &&
        request.resource.data.actorName == get(/databases/$(database)/documents/fantasyDrafts/brian-2026-live/members/$(request.auth.uid)).data.displayName &&
        request.resource.data.updatedAt == request.time;
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function isTripManager(tripId) {
      return isSignedIn() && tripDoc(tripId).data.createdByUid == request.auth.uid;
    }

    function isBanned(tripId) {
      return request.auth != null &&
        tripDoc(tripId).data.bannedUids is list &&
        tripDoc(tripId).data.bannedUids.hasAny([request.auth.uid]);
    }

    function tournamentDoc(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId));
    }

    function isTournamentOwner(tournamentId) {
      return isSignedIn() && tournamentDoc(tournamentId).data.ownerId == request.auth.uid;
    }

    function hasTournamentCoreFields(data) {
      return data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 120 &&
        data.game is string &&
        data.game.size() > 0 &&
        data.game.size() <= 120 &&
        data.format is string &&
        data.format.size() > 0 &&
        data.format.size() <= 120 &&
        data.ownerId is string &&
        data.ownerId.size() > 0 &&
        data.isPublic is bool &&
        data.numberOfPlayers is number &&
        data.numberOfPlayers >= 4 &&
        data.numberOfPlayers <= 16 &&
        data.numberOfPlayers % 2 == 0 &&
        data.players is list &&
        data.players.size() == data.numberOfPlayers &&
        data.teams is list &&
        data.teams.size() >= 2 &&
        data.teams.size() <= 8 &&
        data.settings is map &&
        data.bracket is map &&
        (data.status == "pending" || data.status == "live" || data.status == "completed");
    }

    function isValidMemberPayload(tripId, memberUid) {
      return request.resource.data.keys().hasOnly(["displayName", "role", "joinedAt"]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 24 &&
        request.resource.data.joinedAt is timestamp &&
        request.resource.data.joinedAt >= request.time - duration.value(5, "m") &&
        request.resource.data.joinedAt <= request.time + duration.value(5, "m") &&
        (
          request.resource.data.role == "participant" ||
          (
            request.resource.data.role == "manager" &&
            tripDoc(tripId).data.createdByUid == memberUid
          )
        );
    }

    function hasValidListingUrl(data) {
      return !data.keys().hasAny(["listingUrl"]) ||
        data.listingUrl == null ||
        (data.listingUrl is string && data.listingUrl.matches('^https?://.+'));
    }

    function hasAllowedManagerTripUpdate(before, after) {
      return hasValidListingUrl(after) &&
        after.diff(before).changedKeys().hasOnly([
          "name",
          "listingUrl",
          "listingTitle",
          "listingImageUrl",
          "listingLocationCity",
          "listingLocationState",
          "listingLocationLabel",
          "listingDescription",
          "listingSiteName",
          "listingPreview",
          "listingPreviewUpdatedAt",
          "listingPreviewError",
          "listingBedrooms",
          "listingBeds",
          "listingBaths",
          "sleepingArrangements",
          "totalPrice",
          "roomCount",
          "auctionDurationHours",
          "bidIncrement",
          "antiSnipeWindowMinutes",
          "antiSnipeExtendMinutes",
          "bannedUids",
          "status",
          "auctionStartAt",
          "auctionEndAt",
          "updatedAt"
        ]) &&
        (!after.keys().hasAny(["name"]) || (after.name is string && after.name.size() > 0 && after.name.size() <= 120)) &&
        (!after.keys().hasAny(["listingLocationCity"]) || after.listingLocationCity == null || (after.listingLocationCity is string && after.listingLocationCity.size() <= 120)) &&
        (!after.keys().hasAny(["listingLocationState"]) || after.listingLocationState == null || (after.listingLocationState is string && after.listingLocationState.size() <= 120)) &&
        (!after.keys().hasAny(["listingLocationLabel"]) || after.listingLocationLabel == null || (after.listingLocationLabel is string && after.listingLocationLabel.size() <= 180)) &&
        (!after.keys().hasAny(["listingBedrooms"]) || after.listingBedrooms == null || (after.listingBedrooms is number && after.listingBedrooms >= 0)) &&
        (!after.keys().hasAny(["listingBeds"]) || after.listingBeds == null || (after.listingBeds is number && after.listingBeds >= 0)) &&
        (!after.keys().hasAny(["listingBaths"]) || after.listingBaths == null || (after.listingBaths is number && after.listingBaths >= 0)) &&
        (!after.keys().hasAny(["totalPrice"]) || (after.totalPrice is number && after.totalPrice > 0)) &&
        (!after.keys().hasAny(["roomCount"]) || (after.roomCount is number && after.roomCount >= 1)) &&
        (!after.keys().hasAny(["auctionDurationHours"]) || (after.auctionDurationHours is number && after.auctionDurationHours >= 1)) &&
        (!after.keys().hasAny(["bidIncrement"]) || (after.bidIncrement is number && after.bidIncrement >= 1)) &&
        (!after.keys().hasAny(["antiSnipeWindowMinutes"]) || (after.antiSnipeWindowMinutes is number && after.antiSnipeWindowMinutes >= 0)) &&
        (!after.keys().hasAny(["antiSnipeExtendMinutes"]) || (after.antiSnipeExtendMinutes is number && after.antiSnipeExtendMinutes >= 0)) &&
        (!after.keys().hasAny(["bannedUids"]) || (after.bannedUids is list)) &&
        (!after.keys().hasAny(["status"]) || (after.status == "draft" || after.status == "live" || after.status == "ended"));
    }

    function isValidLinkPreviewPayload(data) {
      return data.keys().hasOnly([
          "url",
          "title",
          "image",
          "description",
          "siteName",
          "hostname",
          "fetchedAt"
        ]) &&
        data.url is string &&
        data.url.matches('^https?://.+') &&
        data.url.size() <= 2048 &&
        (data.title == null || (data.title is string && data.title.size() <= 500)) &&
        (data.image == null || (data.image is string && data.image.matches('^https?://.+') && data.image.size() <= 2048)) &&
        (data.description == null || (data.description is string && data.description.size() <= 4000)) &&
        (data.siteName == null || (data.siteName is string && data.siteName.size() <= 255)) &&
        data.hostname is string &&
        data.hostname.size() > 0 &&
        data.hostname.size() <= 255 &&
        data.fetchedAt is number &&
        data.fetchedAt > 0;
    }

    match /trips/{tripId} {
      // Public read so viewers can open invite links without auth.
      allow read: if true;

      // Trip creation must be authenticated and self-owned.
      allow create: if isSignedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        hasValidListingUrl(request.resource.data);

      // Manager-only trip lifecycle/settings updates.
      // Also allow signed-in bidders to extend only auctionEndAt (anti-sniping).
      allow update: if (isTripManager(tripId) && hasAllowedManagerTripUpdate(resource.data, request.resource.data)) || (
        isSignedIn() &&
        !isBanned(tripId) &&
        resource.data.status == "live" &&
        resource.data.auctionEndAt is timestamp &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["auctionEndAt"]) &&
        request.resource.data.auctionEndAt is timestamp &&
        request.time >= resource.data.auctionEndAt - duration.value(10, "m") &&
        request.time <= resource.data.auctionEndAt &&
        request.resource.data.auctionEndAt > resource.data.auctionEndAt &&
        request.resource.data.auctionEndAt <= resource.data.auctionEndAt + duration.value(10, "m")
      );
      allow delete: if isTripManager(tripId);

      match /rooms/{roomId} {
        // Public read for live auction viewing.
        allow read: if true;

        // Room creation/deletion and manager edits stay manager-only.
        allow create, delete: if isTripManager(tripId);

        // Manager can update any room fields.
        // Signed-in bidders can only update current-high-bid tracking fields.
        allow update: if isTripManager(tripId) || (
          isSignedIn() &&
          !isBanned(tripId) &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "currentHighBidAmount",
            "currentHighBidderUid",
            "currentHighBidAt",
            "currentHighBidTimeMs"
          ]) &&
          request.resource.data.currentHighBidderUid is string &&
          request.resource.data.currentHighBidderUid == request.auth.uid &&
          request.resource.data.currentHighBidAt is timestamp &&
          request.resource.data.currentHighBidAt >= request.time - duration.value(2, "m") &&
          request.resource.data.currentHighBidAt <= request.time + duration.value(2, "m") &&
          request.resource.data.currentHighBidAmount is number &&
          request.resource.data.currentHighBidTimeMs is number &&
          (
            !(resource.data.currentHighBidAmount is number) ||
            request.resource.data.currentHighBidAmount > resource.data.currentHighBidAmount ||
            (
              request.resource.data.currentHighBidAmount == resource.data.currentHighBidAmount &&
              resource.data.currentHighBidTimeMs is number &&
              request.resource.data.currentHighBidTimeMs < resource.data.currentHighBidTimeMs
            ) ||
            (
              resource.data.currentHighBidAmount == 0 &&
              request.resource.data.currentHighBidAmount == 0 &&
              !(resource.data.currentHighBidderUid is string)
            )
          )
        );

        match /bids/{bidId} {
          // Public read so viewers can see live/final auction history if needed.
          allow read: if true;

          // Only signed-in users can place their own bids.
          allow create: if isSignedIn() &&
            !isBanned(tripId) &&
            tripDoc(tripId).data.status == "live" &&
            (
              !(tripDoc(tripId).data.auctionEndAt is timestamp) ||
              request.time <= tripDoc(tripId).data.auctionEndAt
            ) &&
            request.resource.data.keys().hasOnly(["amount", "bidderUid", "bidTimeMs", "createdAt"]) &&
            request.resource.data.bidderUid == request.auth.uid &&
            request.resource.data.amount is number &&
            request.resource.data.bidTimeMs is number &&
            request.resource.data.createdAt is timestamp &&
            request.resource.data.createdAt >= request.time - duration.value(2, "m") &&
            request.resource.data.createdAt <= request.time + duration.value(2, "m");

          // Bids are append-only.
          allow update, delete: if false;
        }
      }

      match /members/{memberUid} {
        // Public read lets viewers see participant display names in live views/results.
        allow read: if true;

        // Users can only create/update their own profile fields.
        // Role escalation is blocked: only the trip creator can use "manager".
        allow create, update: if request.auth != null &&
          !isBanned(tripId) &&
          request.auth.uid == memberUid &&
          isValidMemberPayload(tripId, memberUid);

        // Manager or self can remove a membership record.
        allow delete: if isTripManager(tripId) || (isSignedIn() && !isBanned(tripId) && request.auth.uid == memberUid);
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        hasTournamentCoreFields(request.resource.data);

      allow update: if isTournamentOwner(tournamentId) &&
        hasTournamentCoreFields(request.resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isTournamentOwner(tournamentId);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /myTrips/{tripId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /linkPreviews/{previewId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidLinkPreviewPayload(request.resource.data);
      allow delete: if false;
    }

    match /fantasyDrafts/{draftId}/members/{memberUid} {
      allow get: if draftId == "brian-2026-live" && isSignedIn() &&
        (isFantasyDraftAdmin() || request.auth.uid == memberUid);
      allow list: if draftId == "brian-2026-live" && isFantasyDraftAdmin();
      allow create: if draftId == "brian-2026-live" && isSignedIn() &&
        request.auth.uid == memberUid &&
        request.resource.data.keys().hasOnly(["displayName", "status", "lastSeenAt"]) &&
        isValidFantasyName(request.resource.data.displayName) &&
        request.resource.data.status == "active" && request.resource.data.lastSeenAt == request.time;
      allow update: if draftId == "brian-2026-live" && (
        isFantasyDraftAdmin() || (
          isSignedIn() && request.auth.uid == memberUid && resource.data.status == "active" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "lastSeenAt"]) &&
          isValidFantasyName(request.resource.data.displayName) &&
          request.resource.data.lastSeenAt == request.time
        )
      );
      // Admin may ban a legacy participant who has picks but no membership yet.
      allow create: if draftId == "brian-2026-live" && isFantasyDraftAdmin();
      // Membership cannot be deleted to evade removal.
      allow delete: if false;
    }

    match /fantasyDrafts/{draftId}/picks/{pickId} {
      // Only room members and Brian may read live picks. Removed members lose access.
      allow read: if draftId == "brian-2026-live" && (isFantasyDraftAdmin() || isActiveFantasyMember(draftId));

      // Username-only guests sign in anonymously and can mark an available player taken.
      // Brian's verified login can also add his own picks and correct/reset the board.
      allow create: if draftId == "brian-2026-live" &&
        pickId.matches('^[0-9]{1,3}$') &&
        isActiveFantasyMember(draftId) &&
        isValidSharedFantasyPick(isFantasyDraftAdmin());

      // Picks are immutable. Admin corrections must undo; only a named participant
      // may then draft the available player. Old browser migrations lack origin.
      allow update: if false;

      allow delete: if draftId == "brian-2026-live" && isFantasyDraftAdmin();
    }

    // Survivor has its own public room. Existing feature permissions are unchanged.
    match /survivorDrafts/{draftId} {
      function validShape(d) {
        return d.keys().hasAll(["uids", "names", "nameKeys", "order", "started", "picks"]) &&
          d.keys().hasOnly(["uids", "names", "nameKeys", "order", "started", "picks"]) &&
          d.uids is list && d.names is list && d.nameKeys is list && d.order is list && d.started is bool && d.picks is list &&
          d.uids.size() >= 1 && d.uids.size() <= 4 &&
          d.names.size() == d.uids.size() && d.nameKeys.size() == d.uids.size() && d.order.size() == d.uids.size() &&
          d.uids.toSet().size() == d.uids.size() && d.nameKeys.toSet().size() == d.nameKeys.size() &&
          d.order.toSet().size() == d.order.size() && d.order.hasAll(d.uids) &&
          d.picks.size() <= 20 && d.picks.toSet().size() == d.picks.size() &&
          d.picks.hasOnly(["alexis-levine", "an-thien-an-nguyen", "ana-sani", "angelica-jelly-loblack", "brady-booker", "carter-krull", "cristian-chavez", "danny-kilby-kilby", "devin-way", "eric-macksoud", "jenna-doore", "kristin-flickinger", "lewis-kelly", "linnea-capobianco", "maggie-nestor", "mike-pinsky", "ori-jean-charles", "patt-cannaday", "rob-antonson", "sharonda-cox"]);
      }
      function validTeam(d, index) {
        return d.uids[index] == request.auth.uid &&
          isValidFantasyName(d.names[index]) &&
          d.nameKeys[index] == d.names[index].lower();
      }
      function joinOnly(before, after) {
        let n = before.uids.size();
        return n < 4 && before.picks.size() < 20 && after.started == before.started &&
          after.uids.size() == n + 1 && validTeam(after, n) &&
          after.uids == before.uids.concat([request.auth.uid]) &&
          after.names == before.names.concat([after.names[n]]) &&
          after.nameKeys == before.nameKeys.concat([after.nameKeys[n]]) &&
          after.order == before.order.concat([request.auth.uid]) &&
          after.picks == before.picks;
      }
      function organizerOnly(before, after) {
        return isFantasyDraftAdmin() && before.started == false && before.picks.size() == 0 &&
          ((after.started == false && after.diff(before).affectedKeys().hasOnly(["order"]) &&
            after.order.hasAll(before.order) && after.order.hasOnly(before.order)) ||
           (after.diff(before).affectedKeys().hasOnly(["started", "order"]) &&
            after.started == true && after.order.hasAll(before.order) && after.order.hasOnly(before.order)));
      }
      function pickOnly(before, after) {
        let n = before.picks.size();
        let team = n < 4 ? n : n < 8 ? 7 - n : n < 12 ? n - 8 : n < 16 ? 15 - n : n - 16;
        return before.started == true && n < 20 &&
          before.order[team] == request.auth.uid &&
          after.diff(before).affectedKeys().hasOnly(["picks"]) &&
          after.picks.size() == n + 1 &&
          after.picks == before.picks.concat([after.picks[n]]);
      }
      allow get: if draftId == "survivor-51-2026";
      allow list: if false;
      allow delete: if draftId == "survivor-51-2026" && isFantasyDraftAdmin();
      allow create: if draftId == "survivor-51-2026" && isSignedIn() &&
        validShape(request.resource.data) && request.resource.data.uids.size() == 1 &&
        request.resource.data.order == [request.auth.uid] && request.resource.data.started == false &&
        validTeam(request.resource.data, 0) && request.resource.data.picks.size() == 0;
      allow update: if draftId == "survivor-51-2026" && isSignedIn() &&
        validShape(request.resource.data) &&
        (joinOnly(resource.data, request.resource.data) || organizerOnly(resource.data, request.resource.data) || pickOnly(resource.data, request.resource.data));
    }
    match /survivorSettings/{settingId} {
      function validVideo(d) {
        return d.keys().hasAll(["url"]) && d.keys().hasOnly(["url"]) &&
          d.url is string && d.url.size() <= 500 &&
          (d.url == "" || d.url.matches('^https://[^\\s]+$'));
      }
      allow get: if settingId == "survivor-51-2026";
      allow list, delete: if false;
      allow create, update: if settingId == "survivor-51-2026" && isFantasyDraftAdmin() && validVideo(request.resource.data);
    }
    match /survivorScores/{scoreId} {
      function validScore(d) {
        return d.keys().hasAll(["bootOrder", "jurors", "finalists", "winner", "checkedAt", "sourceUrl"]) &&
          d.keys().hasOnly(["bootOrder", "jurors", "finalists", "winner", "checkedAt", "sourceUrl"]) &&
          d.bootOrder is list && d.jurors is list && d.finalists is list &&
          d.bootOrder.size() <= 17 && d.jurors.size() <= 20 && d.finalists.size() <= 3 &&
          d.bootOrder.toSet().size() == d.bootOrder.size() &&
          d.jurors.toSet().size() == d.jurors.size() &&
          d.finalists.toSet().size() == d.finalists.size() &&
          (d.winner == null || d.winner is string) &&
          d.checkedAt is string && d.sourceUrl == "https://en.wikipedia.org/wiki/Survivor_51";
      }
      allow get: if scoreId == "survivor-51-2026";
      allow list, delete: if false;
      allow create: if scoreId == "survivor-51-2026" && isFantasyDraftAdmin() && validScore(request.resource.data);
      allow update: if scoreId == "survivor-51-2026" && isFantasyDraftAdmin() && validScore(request.resource.data) &&
        request.resource.data.bootOrder.size() >= resource.data.bootOrder.size() &&
        request.resource.data.bootOrder.hasAll(resource.data.bootOrder) &&
        request.resource.data.jurors.hasAll(resource.data.jurors) &&
        request.resource.data.finalists.hasAll(resource.data.finalists) &&
        (resource.data.winner == null || request.resource.data.winner == resource.data.winner);
    }
  }
}
